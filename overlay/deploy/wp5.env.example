IIR_DEPLOY_DIR=
IIR_PYTHON=
IIR_MEDIAMTX_BIN=
IIR_MEDIAMTX_CONFIG=
IIR_CAMERA_UPSTREAM=
IIR_AEC_SOURCE_MASTER=
IIR_AEC_SINK_MASTER=
IIR_AEC_STATE=
PULSE_SERVER=
IIR_AUDIO_SINK=iir_aec_sink
IIR_ASR_SOURCE=iir_aec_source
IIR_RTSP_BASE=rtsp://127.0.0.1:8554
IIR_MEDIAMTX_HTTP_BASE=http://127.0.0.1:8889
IIR_INTERACTION_TOKEN=
IIR_MEDIA_AUTH_SECRET=
IIR_PIPER_MODEL=
IIR_ASR_ENCODER=
IIR_ASR_DECODER=
IIR_ASR_JOINER=
IIR_ASR_TOKENS=
IIR_ASR_VAD_MODEL=
IIR_ASR_RECORD_DIR=
IIR_KWS_ENCODER=
IIR_KWS_DECODER=
IIR_KWS_JOINER=
IIR_KWS_TOKENS=
# install.sh copies deploy/kws/keywords.txt to this path; it must be writable.
# install.sh 会把 deploy/kws/keywords.txt 安装到这个路径，路径需可写。
IIR_KWS_KEYWORDS=
IIR_KWS_EXTRA_KEYWORDS=
IIR_KWS_THREADS=2
IIR_KWS_MAX_ACTIVE_PATHS=8
IIR_KWS_SCORE=1.0
IIR_KWS_THRESHOLD=0.25
IIR_KWS_TRAILING_BLANKS=1
IIR_WAKE_WORD=
IIR_WAKE_WINDOW_SECONDS=6
IIR_ASR_MIN_SILENCE_SECONDS=0.4
IIR_ROS_SETUP=
IIR_ROS_WS_SETUP=
IIR_WEB_BIN=
# Empty = no ROS Web bridge in this deployment; iir-web-bridge exits 0.
# 留空表示本部署不启用 ROS Web 桥接，iir-web-bridge 单元正常退出。
IIR_WEB_BRIDGE=
IIR_CADDY_BIN=
IIR_LAN_DOMAIN=
IIR_TLS_CERT=
IIR_TLS_KEY=
IIR_WEB_ORIGIN=
# WP4 inspection vision options used by iir-vision-rknn.service.
# iir-vision-rknn.service 使用的 WP4 巡检视觉选项。
IIR_RKNN_BACKEND=auto
IIR_RKNN_MODEL=
IIR_RKNN_LABELS=
IIR_CAPTURE_DIR=
# Independent OTA agent paths and STM32 CH9102F download sequencing.
# 独立 OTA 代理路径与 STM32 CH9102F 下载时序。
IIR_OTA_PACKAGE_DIR=~/.cache/iir-ota/packages
IIR_OTA_WORK_DIR=~/.cache/iir-ota/work
IIR_OTA_FW_VERSION=1.0.0
IIR_OTA_MASTER_VERSION=1.0.0
IIR_OTA_MODEL_VERSION=1.0.0
STM32FLASH_INIT_SEQ=
STM32FLASH_EXIT_SEQ=
STM32FLASH_DEVICE=/dev/iir_chassis
# Local inspection Gateway used by the patrol waypoint capture hook.
# 巡逻航点抓拍钩子使用的本机巡检 Gateway 地址。
OPI_GATEWAY_URL=http://127.0.0.1:8089
OPI_WEB_PASSWORD_SHA256=
OPI_BRIDGE_TOKEN=
