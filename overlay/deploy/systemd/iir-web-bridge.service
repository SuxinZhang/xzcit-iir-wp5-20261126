[Unit]
PartOf=iir.target
Description=IIR ROS Web bridge
Requires=iir-web.service
After=iir-web.service

[Service]
Type=exec
EnvironmentFile=%h/.config/iir/wp5.env
ExecStartPre=/usr/bin/python3 ${IIR_DEPLOY_DIR}/wait-ready.py web
ExecStart=/usr/bin/env ${IIR_DEPLOY_DIR}/run-bridge.sh

[Install]
WantedBy=default.target
