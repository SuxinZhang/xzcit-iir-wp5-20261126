[Unit]
PartOf=iir.target
Description=IIR interaction ROS node
Requires=iir-audio.service
After=iir-audio.service

[Service]
Type=exec
EnvironmentFile=%h/.config/iir/wp5.env
ExecStartPre=/usr/bin/python3 ${IIR_DEPLOY_DIR}/wait-ready.py audio
ExecStart=/usr/bin/env ${IIR_DEPLOY_DIR}/run-ros.sh

[Install]
WantedBy=default.target
